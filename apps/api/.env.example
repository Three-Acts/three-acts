# Browser origins allowed to call the API directly (cross-origin). Normal
# traffic is same-origin via the /api/* rewrite, so this is only needed for
# direct browser calls. Defaults (used when this is unset) already include
# the Vite dev ports (5173/5174) and the Astro dev/preview ports (4321 dev,
# 4173 preview) on localhost and 127.0.0.1.
API_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Publishing (CMS "Publish" -> Vercel deploy) ---
# Shared secret the CMS sends as `Authorization: Bearer <PUBLISH_TOKEN>` to
# call /api/deploy and /api/deploy-status. When unset, those endpoints allow
# unauthenticated requests outside production (VERCEL_ENV !== "production")
# and respond 503 in production, so publishing never runs unauthenticated live.
PUBLISH_TOKEN=
# Deploy Hook URL for the web project (Vercel > Project > Settings > Git > Deploy Hooks).
VERCEL_DEPLOY_HOOK_URL=
# Token + project used to poll live deployment status (Vercel > Account > Tokens).
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Optional, for team-scoped projects.
VERCEL_TEAM_ID=
# Optional override for the Vercel REST API base URL (self-hosted proxies or
# local testing). Defaults to https://api.vercel.com.
VERCEL_API_BASE=

# --- Supabase (server-side, privileged) ---
# Service-role key bypasses RLS -- server-only, never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- CMS backend (/api/cms/*) ---
# Selects the storage implementation behind the CMS data/record routes and
# the asset-upload routes, independently. Each is "supabase" | "file" | "memory".
# When unset, each defaults to "supabase" if SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY are both set above; otherwise "file" outside
# production/Vercel, or "memory" when running in production or on Vercel
# (VERCEL or VERCEL_ENV set) — the file store's directory isn't durable
# there. "file" persists one JSON file per collection (and uploads) under
# CMS_DATA_DIR across restarts; "memory" resets on every restart and never
# persists across separate Vercel invocations. Either way `npm run dev`
# works with zero external services configured.
CMS_DATA_BACKEND=
CMS_STORAGE_BACKEND=
# Directory the "file" data/storage backend reads and writes: one
# <collectionId>.json per collection (seeded from the shared dev dataset on
# first access, outside production) plus uploads/<bucket>/<path> for asset
# uploads (served back at /api/uploads/<bucket>/<path>). Resolved relative to
# the apps/api package directory, not the process cwd. Defaults to ./data,
# which is gitignored except a data/.gitkeep.
CMS_DATA_DIR=./data
# All /api/cms/* routes require CMS auth: either a `cms`-scoped session token
# (see below) or the legacy PUBLISH_TOKEN bearer above (see requireAuth in
# api/_lib/auth.ts, which now re-exports requireCmsAuth from api/_lib/auth/sessions.ts).

# --- Auth (/api/auth/*) ---
# Secret that signs/verifies session tokens (api/_lib/auth/sessions.ts, via
# @three-acts/auth/server). Outside production, an unset value falls back to
# a fixed dev secret ("three-acts-dev-secret") so local dev/tests need zero
# config; production responds 503 ("auth_unconfigured") on every auth route
# until this is set — sessions must never be signed with a value every clone
# of this repo shares.
AUTH_SECRET=
# Session token lifetime, in seconds. Defaults to 1209600 (14 days).
AUTH_TOKEN_TTL_SECONDS=1209600
# How /api/auth/sign-in authenticates scope:"cms" (editor) sign-ins:
# "open" (the dev default outside production): any non-empty email/password
# signs in. "env" (the production default): must match an entry in
# CMS_EDITORS below. Unset picks "open" outside production, "env" in
# production.
CMS_AUTH_MODE=
# Editor credentials for CMS_AUTH_MODE=env, as "email:password,email:password".
CMS_EDITORS=
# Whether a seeded/site-created `customers` record with no identity yet may
# sign in (scope "shop") with any password on first try — that password is
# then stored as its identity going forward. A dev/demo convenience, not
# something to leave on live: defaults to true outside production, false in
# production.
SHOP_OPEN_PASSWORDS=

# --- Payments (/api/shop/checkout) ---
# Selects the PaymentProvider api/_lib/shop/checkout.ts charges through.
# "mock" is the only implementation today (api/_lib/shop/payments.ts):
# card/apple_pay/paypal/gift_card settle immediately ("paid"), eft comes back
# "awaiting". Unset defaults to "mock"; any other value responds 503
# "payment_unconfigured" rather than silently charging through nothing. Add a
# real provider (Stripe, PayFast, ...) by implementing PaymentProvider and
# registering it in getPaymentProvider() — see the comment there for the plug-in steps.
PAYMENT_PROVIDER=mock

# To add another backend (plain Postgres via pg/Drizzle, Cloudflare R2 via the
# S3 API, ...), implement CmsDataStore / CmsBlobStore in api/_lib/cms and
# register it in api/_lib/cms/resolve-store.ts. `npm run schema:sql -w
# @three-acts/api` prints CREATE TABLE SQL for any Postgres-compatible target.
# For incremental changes against an existing database, use `npm run
# schema:diff -w @three-acts/api` (prints the migration) or `schema:migrate`
# (also writes apps/api/schema/migrations/*.sql and updates snapshot.json).
