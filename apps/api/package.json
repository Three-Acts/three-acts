{
  "name": "@three-acts/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev-server.ts",
    "dev:vercel": "vercel dev --yes --listen 0.0.0.0:5175",
    "build": "tsc -p tsconfig.app.json --noEmit",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "schema:sql": "tsx scripts/print-schema.ts",
    "schema:json": "tsx scripts/print-schema-json.ts",
    "schema:diff": "tsx scripts/diff-schema.ts",
    "schema:migrate": "tsx scripts/diff-schema.ts --write"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@vercel/node": "^5.5.13",
    "tsx": "^4.21.0",
    "vercel": "^48.10.3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@three-acts/auth": "*",
    "@three-acts/cms-schema": "*",
    "@three-acts/ecommerce": "*",
    "@three-acts/forms": "*"
  }
}
