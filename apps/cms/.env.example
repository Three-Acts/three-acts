API_ORIGIN=http://localhost:5175

# Which CmsBackend (and matching AuthClient) the workspace uses:
# "rest" (the default documented here) talks to the real API's /api/cms/*
# and /api/auth/* routes (see @three-acts/cms-schema and @three-acts/auth) —
# signing in calls POST /api/auth/sign-in and stores the returned session.
# "mock" is the zero-backend path: an in-memory adapter with generated seed
# data, no network calls, and a local-only auth client that accepts any
# email/password and never persists across a reload. Leaving this var unset
# entirely (not just blank) also falls back to "mock" in code, so a fresh
# checkout with no .env file still runs with zero configuration.
VITE_CMS_BACKEND=rest

# Only used when VITE_CMS_BACKEND=rest: where the API lives. Point this at the
# API dev server directly, or leave it unset to go through the dev proxy.
VITE_API_URL=

# Optional legacy fallback bearer token, attached as
# `Authorization: Bearer <token>` only when no session is stored yet (before
# sign-in, or scripts/CI that never sign in). Must exactly match the API
# server's own PUBLISH_TOKEN env var to be accepted. Not required for normal
# use of VITE_CMS_BACKEND=rest, since /api/auth/sign-in issues a real
# cms-scoped session token automatically; VITE_CMS_BACKEND=mock never uses it
# either (its local auth client isn't backed by a real session).
VITE_PUBLISH_TOKEN=
