---
import { loadArticles, loadFaqs, loadProductCategories, loadProducts, loadTestimonials } from "../content/loaders";
import BaseLayout from "../layouts/BaseLayout.astro";
import { homeMeta } from "../page-meta";
import { HomePage } from "../views/home";
import { HomeCompositionPreview } from "../components/editor/home-composition-preview";

const [products, categories, articles, testimonials, faqs] = await Promise.all([
  loadProducts(),
  loadProductCategories(),
  loadArticles(),
  loadTestimonials(),
  loadFaqs()
]);
const meta = await homeMeta();
const editorPreview = import.meta.env.DEV || import.meta.env.PUBLIC_EDITOR_PREVIEW === "true";
const editorOrigin = import.meta.env.PUBLIC_EDITOR_ORIGIN || (import.meta.env.DEV ? "http://localhost:5174" : "");
---

<BaseLayout seo={meta.seo}>
  {editorPreview && editorOrigin ? <HomeCompositionPreview client:load origin={editorOrigin} products={products} categories={categories} articles={articles} testimonials={testimonials} faqs={faqs}/> : <HomePage products={products} categories={categories} articles={articles} testimonials={testimonials} faqs={faqs}/>}
</BaseLayout>
