---
import { loadArticles } from "../content/loaders";
import { Notice } from "../components/ui/notice";
import { formatDate } from "../lib/format";
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta, isPageLive } from "../page-meta";
import { InfoPage } from "../views/info/InfoPage";

const meta = await infoPageMeta("/changelog", {
  title: "Changelog",
  description: "Recent releases and what changed in each one."
});

const [live, articles] = await Promise.all([isPageLive("/changelog"), loadArticles()]);

const releases = articles
  .filter((article) => article.categorySlug === "release-notes")
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 6)
  .map((article) => ({
    heading: article.title,
    body: `${formatDate(article.publishedAt)}\n\n${article.excerpt}\n\n/blog/${article.slug}`
  }));
---

<BaseLayout seo={meta.seo}>
  <InfoPage eyebrow="Changelog" title="Changelog" lede="What shipped, and when." sections={releases}>
    {
      !live && (
        <Notice.Root tone="info" title="Coming soon" className="mb-12 desktop:mb-16">
          The full changelog isn't live yet — here are the most recent releases from the journal in the meantime.
        </Notice.Root>
      )
    }
  </InfoPage>
</BaseLayout>
