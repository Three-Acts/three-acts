---
import copy from "@three-acts/static-content/documents/changelog.json";
import { loadArticles } from "../content/loaders";
import { Notice } from "../components/ui/notice";
import { formatDate } from "../lib/format";
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta, isPageLive } from "../page-meta";
import { InfoPage } from "../views/info/InfoPage";

const meta = await infoPageMeta("/changelog", copy.changelog.metadata_1);

const [live, articles] = await Promise.all([isPageLive("/changelog"), loadArticles()]);

const releases = articles
  .filter((article) => article.categorySlug === "release-notes")
  .sort((a, b) => new Date(b.publishedAt).getTime() - new Date(a.publishedAt).getTime())
  .slice(0, 6)
  .map((article) => ({
    heading: article.title,
    body: `${formatDate(article.publishedAt)}\n\n${article.excerpt}\n\n/blog/${article.slug}`
  }));
---

<BaseLayout seo={meta.seo}>
  <InfoPage staticHeaderFields={{"eyebrow": "changelog.changelog.eyebrow_2", "title": "changelog.changelog.title_5", "lede": "changelog.changelog.lede_4"}} eyebrow={copy.changelog.eyebrow_2} title={copy.changelog.title_3} lede={copy.changelog.lede_4} sections={releases}>
    {
      !live && (
        <Notice.Root tone="info" title={copy.changelog.title_5} className="mb-12 desktop:mb-16">
          <span data-static-field="changelog.changelog.root_6">{copy.changelog.root_6}</span></Notice.Root>
      )
    }
  </InfoPage>
</BaseLayout>
