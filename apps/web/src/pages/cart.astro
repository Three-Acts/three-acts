---
import CartPage from "../components/islands/cart-page";
import { Section } from "../components/layout/section";
import { Typography } from "../components/ui/typography";
import BaseLayout from "../layouts/BaseLayout.astro";
import { cartMeta } from "../page-meta";
---

<BaseLayout seo={cartMeta.seo}>
  <Section.Root>
    <Section.Container>
      <Typography.Title as="h1">Your cart</Typography.Title>
      <div class="mt-10">
        <CartPage client:load />
      </div>
    </Section.Container>
  </Section.Root>
</BaseLayout>
