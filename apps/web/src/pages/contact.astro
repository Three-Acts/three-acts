---
import ContactDetails from "../components/info/contact-details";
import ContactForm from "../components/islands/contact-form";
import { Section } from "../components/layout/section";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactMeta } from "../page-meta";

const meta = await contactMeta();
---

<BaseLayout seo={meta.seo}>
  <Section.Root>
    <Section.Container>
      <div class="grid gap-x-gap gap-y-gap-y landscape:grid-cols-2">
        <div class="flex flex-col">
          <Section.Header
            eyebrow="Contact"
            title="Get in touch"
            lede="Questions about the template, a licence or an order — we reply within one working day."
          />
          <ContactDetails />
        </div>
        <ContactForm client:visible />
      </div>
    </Section.Container>
  </Section.Root>
</BaseLayout>
