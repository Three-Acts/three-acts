---
import InquiryForm from "../components/islands/inquiry-form";
import { Section } from "../components/layout/section";
import { Typography } from "../components/ui/typography";
import BaseLayout from "../layouts/BaseLayout.astro";
import { wholesaleMeta } from "../page-meta";
import { site } from "../site";

const meta = await wholesaleMeta();

const whatYouGet = [
  "Roasted-to-order 1 kg bags, delivered weekly on a fixed roast day",
  "Complimentary barista training for your team when you come on board",
  "Equipment support — loaner machines, maintenance visits and service call-outs for gear we supply",
  "A dedicated account contact and priority scheduling around your busiest trading days",
  "Flexible invoicing for standing weekly or fortnightly orders"
];
---

<BaseLayout seo={meta.seo}>
  <Section.Root className="py-16 desktop:py-24">
    <Section.Container className="max-w-5xl">
      <Typography.Eyebrow>Wholesale</Typography.Eyebrow>
      <Typography.Display className="mt-5 text-5xl landscape:text-6xl">Coffee for your café, office or restaurant.</Typography.Display>
      <Typography.Lede className="mt-6">
        We roast to order for cafés, offices and restaurants across the Western Cape — the same beans that go into
        our own bags, in 1&nbsp;kg format, with the training and equipment support to back them.
      </Typography.Lede>

      <div class="mt-14 grid gap-12 landscape:grid-cols-2 landscape:gap-16">
        <div class="flex flex-col gap-10">
          <div class="flex flex-col gap-4">
            <h2 class="text-sm font-semibold uppercase tracking-eyebrow text-moss">What you get</h2>
            <ul class="flex flex-col gap-3">
              {
                whatYouGet.map((item) => (
                  <li class="grid grid-cols-check items-start gap-3 text-base leading-7 text-ink">
                    <span aria-hidden="true" class="mt-1 flex size-7 shrink-0 items-center justify-center border border-line-strong/30 text-xs font-semibold text-moss">
                      ✓
                    </span>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div class="border border-line bg-surface-raised p-5">
            <h2 class="text-sm font-semibold uppercase tracking-eyebrow text-moss">Pricing</h2>
            <p class="mt-3 text-sm leading-6 text-muted">
              Wholesale pricing scales with volume — most independent cafés land in our standard tier, with better
              rates at higher weekly kilos. Tell us roughly how much you go through and where you're based, and
              we'll send a tailored price list within two working days.
            </p>
          </div>

          <div class="flex flex-col gap-2 text-sm text-muted">
            <p>Prefer to talk it through first?</p>
            <a href={`mailto:${site.email}`} class="focus-ring w-fit font-medium text-ink hover:text-accent">
              {site.email}
            </a>
            <a href={`tel:${site.phoneHref}`} class="focus-ring w-fit font-medium text-ink hover:text-accent">
              {site.phone}
            </a>
          </div>
        </div>

        <InquiryForm client:visible />
      </div>
    </Section.Container>
  </Section.Root>
</BaseLayout>
