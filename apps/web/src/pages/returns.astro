---
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { site } from "../site";
import { InfoPage } from "../views/info/InfoPage";

const meta = await infoPageMeta("/returns", {
  title: "Returns & refunds",
  description: "Unopened coffee and gear faults, returned within 14 days — here's how it works."
});

const sections = [
  {
    heading: "Coffee",
    body: "Because we roast to order, we can't resell an opened bag — but if a coffee arrives stale, damaged or isn't what you ordered, tell us within 14 days of delivery and we'll replace it or refund it, no questions asked. Unopened bags can be returned within the same 14 days for a full refund."
  },
  {
    heading: "Brewing gear",
    body: "Grinders, drippers, kettles and other gear can be returned within 14 days of delivery, unused and in its original packaging, for a full refund. If it arrives faulty or develops a fault covered by the manufacturer's warranty, we'll repair, replace or refund it — send us photos or a short video and we'll take it from there."
  },
  {
    heading: "How to start a return",
    body: `Email ${site.email} with your order number and what's wrong. We'll confirm the next step by reply — usually a prepaid courier collection for gear, or a quick refund for coffee.`
  },
  {
    heading: "Refunds",
    body: "Once we've received a returned item (or approved a coffee issue without needing it back), refunds land on your original payment method within 5–7 working days. Shipping costs on the original order are refunded only when the return is our error — a wrong or faulty item."
  }
];
---

<BaseLayout seo={meta.seo}>
  <InfoPage title="Returns & refunds" lede="Coffee that isn't right, or gear that doesn't work — here's how we put it right." sections={sections} />
</BaseLayout>
