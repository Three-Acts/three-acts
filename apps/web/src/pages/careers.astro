---
import { resolveStaticContent } from "@three-acts/static-content";
import copyData from "@three-acts/static-content/documents/careers.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { site } from "../site";
import { InfoPage } from "../views/info/InfoPage";

const copy = resolveStaticContent(copyData, { "site.name": site.name, "site.email": site.email });

const meta = await infoPageMeta("/careers", copy.careers.metadata_1);

const sections = copy.careers.sections_2;
---

<BaseLayout seo={meta.seo}>
  <InfoPage staticHeaderFields={{"eyebrow": "careers.careers.eyebrow_3", "title": "careers.careers.title_4", "lede": "careers.careers.lede_5"}} staticContentPrefix="careers.careers.sections_2" eyebrow={copy.careers.eyebrow_3} title={copy.careers.title_4} lede={copy.careers.lede_5} sections={sections} />
</BaseLayout>
