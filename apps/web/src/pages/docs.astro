---
import copy from "@three-acts/static-content/documents/docs.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { InfoPage } from "../views/info/InfoPage";

const meta = await infoPageMeta("/docs", copy.docs.metadata_1);

const sections = copy.docs.sections_2;
---

<BaseLayout seo={meta.seo}>
  <InfoPage staticHeaderFields={{"eyebrow": "docs.docs.eyebrow_3", "title": "docs.docs.title_4", "lede": "docs.docs.lede_5"}} staticContentPrefix="docs.docs.sections_2"
    eyebrow={copy.docs.eyebrow_3}
    title={copy.docs.title_4}
    lede={copy.docs.lede_5}
    sections={sections}
  />
</BaseLayout>
