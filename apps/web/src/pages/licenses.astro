---
import copy from "@three-acts/static-content/documents/licenses.json";
import { loadProducts } from "../content/loaders";
import LicenseTiers from "../components/info/license-tiers";
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { InfoPage } from "../views/info/InfoPage";

const LICENSE_SLUGS = ["single-site-license", "agency-license", "unlimited-license"] as const;

const products = await loadProducts();
const licenses = LICENSE_SLUGS.map((slug) => products.find((product) => product.slug === slug)).filter(
  (product): product is NonNullable<typeof product> => Boolean(product)
);

const meta = await infoPageMeta("/licenses", copy.licenses.metadata_1);

const sections = copy.licenses.sections_2;
---

<BaseLayout seo={meta.seo}>
  <InfoPage staticHeaderFields={{"eyebrow": "licenses.licenses.eyebrow_3", "title": "licenses.licenses.title_4", "lede": "licenses.licenses.lede_5"}} staticContentPrefix="licenses.licenses.sections_2"
    eyebrow={copy.licenses.eyebrow_3}
    title={copy.licenses.title_4}
    lede={copy.licenses.lede_5}
    sections={sections}
  >
    <LicenseTiers licenses={licenses} />
  </InfoPage>
</BaseLayout>
