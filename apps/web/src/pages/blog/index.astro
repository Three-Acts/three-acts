---
import { loadArticleCategories, loadArticles, loadAuthors } from "../../content/loaders";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogIndexMeta } from "../../page-meta";
import { BlogIndexPage } from "../../views/blog/BlogIndexPage";

const [articles, categories, authors] = await Promise.all([loadArticles(), loadArticleCategories(), loadAuthors()]);
const meta = await blogIndexMeta();
---

<BaseLayout seo={meta.seo}>
  <BlogIndexPage articles={articles} categories={categories} authors={authors} />
</BaseLayout>
