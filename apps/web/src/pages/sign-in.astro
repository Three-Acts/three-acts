---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignInForm from "../components/islands/sign-in-form";
import { Section } from "../components/layout/section";
import { Typography } from "../components/ui/typography";
import { signInMeta } from "../page-meta/builders";
---

<BaseLayout seo={signInMeta.seo}>
  <Section.Root>
    <Section.Container>
      <div class="mx-auto flex w-full max-w-md flex-col gap-6 border border-line-strong bg-surface p-8">
        <Typography.Title as="h1" className="text-center">
          Sign in to your Three Acts account
        </Typography.Title>
        <SignInForm client:load />
      </div>
    </Section.Container>
  </Section.Root>
</BaseLayout>
