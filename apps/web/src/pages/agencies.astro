---
import InquiryForm from "../components/islands/inquiry-form";
import { Grid } from "../components/layout/grid";
import { Section } from "../components/layout/section";
import { Typography } from "../components/ui/typography";
import BaseLayout from "../layouts/BaseLayout.astro";
import { agenciesMeta } from "../page-meta";

const meta = await agenciesMeta();

const VALUE_CARDS = [
  {
    title: "White-label",
    body: "Ship it under your own brand — every client-facing page, email and CMS login carries your name, not ours.",
    bullets: [
      "No Three Acts branding on any client-facing page",
      "Your logo and domain on the CMS login",
      "Client-ready docs you can reskin"
    ]
  },
  {
    title: "Agency licence",
    body: "One licence covers unlimited client sites — no per-site fee, ever, and it pays for itself after two or three builds for most studios.",
    bullets: ["Unlimited client sites under one licence", "No recurring per-project cost", "Upgrade to Unlimited any time for the price difference"]
  },
  {
    title: "Partner support",
    body: "A direct line to the people who build the template, for the questions a support ticket can't answer.",
    bullets: [
      "Priority email support, one working day reply",
      "Architecture guidance for non-standard requirements",
      "Early access to new releases"
    ]
  }
];

const STEPS = [
  {
    title: "Apply for an agency licence",
    description: "Tell us about your studio and the kind of client work you do through the form below. We reply within two working days."
  },
  {
    title: "Get repo access",
    description: "We add you to the private GitHub repo under the agency licence — clone it for every client project from there."
  },
  {
    title: "Fork per client",
    description: "Rename the brand, configure the registry, and ship — the same steps as the docs, once per client site."
  },
  {
    title: "Lean on partner support",
    description: "Email us when something's non-standard for a client build. We reply within one working day."
  }
];
---

<BaseLayout seo={meta.seo}>
  <Section.Root>
    <Section.Container>
      <Section.Header
        eyebrow="Agencies"
        title="Build client sites on Three Acts"
        lede="An agency licence covers unlimited client sites under your own brand, with a direct line to the people who build the template."
      />
      <Grid.Root cols={3}>
        {
          VALUE_CARDS.map((card) => (
            <div class="flex flex-col gap-4 border border-line-strong bg-surface p-6 desktop:p-8">
              <h3 class="text-h3 font-medium text-ink">{card.title}</h3>
              <p class="text-body text-ink">{card.body}</p>
              <ul class="flex flex-col gap-2 pl-5 text-body text-ink marker:text-ink list-[square]">
                {card.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </Grid.Root>
    </Section.Container>
  </Section.Root>

  <Section.Root className="pt-0">
    <Section.Container>
      <Typography.Title className="mb-10 desktop:mb-12">How it works</Typography.Title>
      <div class="flex flex-col">
        {
          STEPS.map((step, index) => (
            <div class="grid gap-4 border-t border-line py-8 landscape:grid-cols-[120px_1fr] landscape:gap-x-gap">
              <span aria-hidden="true" class="text-h2 font-normal text-ink">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="flex flex-col gap-2">
                <h3 class="text-h3 font-medium text-ink">{step.title}</h3>
                <p class="text-body text-ink">{step.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </Section.Container>
  </Section.Root>

  <Section.Root className="pt-0">
    <Section.Container className="max-w-3xl">
      <Typography.Title className="mb-10 desktop:mb-12">Tell us about the project</Typography.Title>
      <InquiryForm client:visible />
    </Section.Container>
  </Section.Root>
</BaseLayout>
