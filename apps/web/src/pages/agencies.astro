---
import copy from "@three-acts/static-content/documents/agencies.json";
import InquiryForm from "../components/islands/inquiry-form";
import { Grid } from "../components/layout/grid";
import { Section } from "../components/layout/section";
import { Typography } from "../components/ui/typography";
import BaseLayout from "../layouts/BaseLayout.astro";
import { agenciesMeta } from "../page-meta";

const meta = await agenciesMeta();

const VALUE_CARDS = copy.agencies.value_cards_1;

const STEPS = copy.agencies.steps_2;
---

<BaseLayout seo={meta.seo}>
  <Section.Root>
    <Section.Container>
      <Section.Header
        eyebrow={copy.agencies.eyebrow_3}
        title={copy.agencies.title_4}
        lede={copy.agencies.lede_5}
      />
      <Grid.Root cols={3}>
        {
          VALUE_CARDS.map((card) => (
            <div class="flex flex-col gap-4 border border-line-strong bg-surface p-6 desktop:p-8">
              <h3 class="text-h3 font-medium text-ink">{card.title}</h3>
              <p class="text-body text-ink">{card.body}</p>
              <ul class="flex flex-col gap-2 pl-5 text-body text-ink marker:text-ink list-[square]">
                {card.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </Grid.Root>
    </Section.Container>
  </Section.Root>

  <Section.Root className="pt-0">
    <Section.Container>
      <Typography.Title className="mb-10 desktop:mb-12"><span data-static-field="agencies.agencies.title_6">{copy.agencies.title_6}</span></Typography.Title>
      <div class="flex flex-col">
        {
          STEPS.map((step, index) => (
            <div class="grid gap-4 border-t border-line py-8 landscape:grid-cols-[120px_1fr] landscape:gap-x-gap">
              <span aria-hidden="true" class="text-h2 font-normal text-ink">
                {String(index + 1).padStart(2, "0")}
              </span>
              <div class="flex flex-col gap-2">
                <h3 class="text-h3 font-medium text-ink">{step.title}</h3>
                <p class="text-body text-ink">{step.description}</p>
              </div>
            </div>
          ))
        }
      </div>
    </Section.Container>
  </Section.Root>

  <Section.Root className="pt-0">
    <Section.Container className="max-w-3xl">
      <Typography.Title className="mb-10 desktop:mb-12"><span data-static-field="agencies.agencies.title_7">{copy.agencies.title_7}</span></Typography.Title>
      <InquiryForm client:visible />
    </Section.Container>
  </Section.Root>
</BaseLayout>
