---
import { shopConfig } from "@three-acts/ecommerce";
import { formatMoney } from "../lib/format";
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { InfoPage } from "../views/info/InfoPage";

const meta = await infoPageMeta("/shipping", {
  title: "Shipping & delivery",
  description: `${formatMoney(shopConfig.shipping.domestic, shopConfig.currency)} standard delivery nationwide, free over ${formatMoney(shopConfig.shipping.freeOverInclVat, shopConfig.currency)}.`
});

const domestic = formatMoney(shopConfig.shipping.domestic, shopConfig.currency);
const freeOver = formatMoney(shopConfig.shipping.freeOverInclVat, shopConfig.currency);
const international = formatMoney(shopConfig.shipping.international, shopConfig.currency);

const sections = [
  {
    heading: "Domestic delivery",
    body: `Standard delivery anywhere in South Africa is a flat ${domestic}, and free on orders over ${freeOver}. We ship with TCG Courier on the mainline routes and PUDO to locker and door points outside the main centres — you'll see whichever's fastest to your postal code at checkout.`
  },
  {
    heading: "International delivery",
    body: `Outside South Africa, delivery is a flat ${international} regardless of order size, with customs and import duties (if any) for your country payable on arrival — we can't predict or prepay these on your behalf.`
  },
  {
    heading: "Roast date & dispatch",
    body: "We roast Monday to Thursday and only ship what's already been roasted, so every order goes out within 48 hours of your beans coming off the drum. You'll get a dispatch email with a tracking link the moment it leaves the roastery."
  },
  {
    heading: "Tracking your order",
    body: "Every dispatch email includes a tracking number for TCG or PUDO. Signed-in customers can also see live status on any order from their account's order history."
  },
  {
    heading: "Collection",
    body: "Skip delivery entirely and collect from the roastery in Observatory at no charge — choose \"Collection\" at checkout and we'll email you when your order's ready, usually the same day it's roasted."
  }
];
---

<BaseLayout seo={meta.seo}>
  <InfoPage
    title="Shipping & delivery"
    lede="How and when your coffee gets to you, wherever you are."
    sections={sections}
  />
</BaseLayout>
