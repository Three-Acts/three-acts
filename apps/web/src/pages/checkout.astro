---
import CheckoutForm from "../components/islands/checkout-form";
import { Section } from "../components/layout/section";
import { Typography } from "../components/ui/typography";
import BaseLayout from "../layouts/BaseLayout.astro";
import { checkoutMeta } from "../page-meta";
---

<BaseLayout seo={checkoutMeta.seo}>
  <Section.Root>
    <Section.Container>
      <Typography.Title as="h1">Checkout</Typography.Title>
      <div class="mt-10">
        <CheckoutForm client:load />
      </div>
    </Section.Container>
  </Section.Root>
</BaseLayout>
