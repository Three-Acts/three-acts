---
import { resolveStaticContent } from "@three-acts/static-content";
import copyData from "@three-acts/static-content/documents/terms.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { site } from "../site";
import { InfoPage } from "../views/info/InfoPage";

const copy = resolveStaticContent(copyData, { "site.name": site.name, "site.email": site.email });

const meta = await infoPageMeta("/terms", copy.terms.metadata_1);

const sections = copy.terms.sections_2;
---

<BaseLayout seo={meta.seo}>
  <InfoPage staticHeaderFields={{"eyebrow": "terms.terms.eyebrow_3", "title": "terms.terms.title_4", "lede": "terms.terms.lede_5"}} staticContentPrefix="terms.terms.sections_2" eyebrow={copy.terms.eyebrow_3} title={copy.terms.title_4} lede={copy.terms.lede_5} sections={sections} />
</BaseLayout>
