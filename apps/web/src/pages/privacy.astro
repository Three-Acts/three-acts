---
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { site } from "../site";
import { InfoPage } from "../views/info/InfoPage";

const meta = await infoPageMeta("/privacy", {
  title: "Privacy policy",
  description: `How ${site.name} collects, uses and protects your personal information.`
});

const sections = [
  {
    heading: "What we collect",
    body: "When you buy a licence, sign up, subscribe to updates or contact us, we collect what's needed to act on it — your name, email and order history. We never collect card details ourselves; payment is handled by our payment provider directly."
  },
  {
    heading: "Why we collect it",
    body: "- To process an order and grant repository access\n- To run your account, including order history and licence records\n- To send order and update emails you can't opt out of while you have an active licence\n- To send marketing emails, only if you've opted in, and only until you unsubscribe\n- To respond to a message sent through our contact or agency enquiry forms"
  },
  {
    heading: "How we protect it",
    body: "Your information is stored with providers that meet current security standards, accessed only by the people who need it to run the business and support your order. We don't sell your personal information to anyone."
  },
  {
    heading: "Your rights",
    body: `Wherever you're based, you can ask us what we hold about you, ask us to correct or delete it, and withdraw marketing consent at any time — including under South Africa's POPIA and the EU/UK GDPR, where they apply. Email ${site.email} and we'll respond within a reasonable time.`
  },
  {
    heading: "Cookies",
    body: "We use a small number of cookies to keep your cart working across pages and to understand which pages people find useful. None of them are used to build an advertising profile of you."
  },
  {
    heading: "Changes to this policy",
    body: `We'll update this page if how we handle your information changes materially. Questions in the meantime? Email ${site.email}.`
  }
];
---

<BaseLayout seo={meta.seo}>
  <InfoPage eyebrow="Legal" title="Privacy policy" lede="How we collect, use and protect your personal information." sections={sections} />
</BaseLayout>
