---
import { resolveStaticContent } from "@three-acts/static-content";
import copyData from "@three-acts/static-content/documents/privacy.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { site } from "../site";
import { InfoPage } from "../views/info/InfoPage";

const copy = resolveStaticContent(copyData, { "site.name": site.name, "site.email": site.email });

const meta = await infoPageMeta("/privacy", copy.privacy.metadata_1);

const sections = copy.privacy.sections_2;
---

<BaseLayout seo={meta.seo}>
  <InfoPage staticHeaderFields={{"eyebrow": "privacy.privacy.eyebrow_3", "title": "privacy.privacy.title_4", "lede": "privacy.privacy.lede_5"}} staticContentPrefix="privacy.privacy.sections_2" eyebrow={copy.privacy.eyebrow_3} title={copy.privacy.title_4} lede={copy.privacy.lede_5} sections={sections} />
</BaseLayout>
