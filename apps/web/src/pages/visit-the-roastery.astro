---
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { site } from "../site";
import { InfoPage } from "../views/info/InfoPage";

const meta = await infoPageMeta("/visit-the-roastery", {
  title: "Visit the roastery",
  description: "Coffee, cupping sessions and fresh bags straight off the roaster at our Observatory space."
});

const hoursText = site.hours.map((entry) => `${entry.days}: ${entry.hours}`).join("\n");

const sections = [
  {
    heading: "Where we are",
    body: `${site.address.street}, ${site.address.locality}, ${site.address.postalCode}, ${site.address.country}.\n\nThe roastery and espresso bar share one open room — you can watch a batch come off the drum while you wait for your order.`
  },
  {
    heading: "Opening hours",
    body: `${hoursText}\n\nClosed Sundays and public holidays. The espresso bar keeps the same hours as the roastery.`
  },
  {
    heading: "The brew bar",
    body: "Filter, espresso and a rotating guest cup from whatever's freshest off the roaster that week — order at the counter, no booking needed. Beans are available to buy by the bag on the way out, always roasted within the last few days."
  },
  {
    heading: "Cupping sessions",
    body: "We run a public cupping every Saturday at 9:30, tasting the week's roasts side by side with the team that roasted them. It's free, takes about 45 minutes, and no coffee experience is required — just email ahead so we know how many cups to pour."
  },
  {
    heading: "Parking & getting here",
    body: "Metered street parking runs along Lower Main Road, usually easiest before 9am or after 4pm. We're a five-minute walk from Observatory train station and on the MyCiTi T01 route, with secure bike racks at the front door."
  }
];
---

<BaseLayout seo={meta.seo}>
  <InfoPage
    title="Visit the roastery"
    lede="Come and see where the coffee gets roasted — the espresso bar, the brew bar and the Saturday cupping table are all open to anyone who wants a cup."
    sections={sections}
  />
</BaseLayout>
