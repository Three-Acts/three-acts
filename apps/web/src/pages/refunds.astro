---
import { resolveStaticContent } from "@three-acts/static-content";
import copyData from "@three-acts/static-content/documents/refunds.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import { infoPageMeta } from "../page-meta";
import { site } from "../site";
import { InfoPage } from "../views/info/InfoPage";

const copy = resolveStaticContent(copyData, { "site.name": site.name, "site.email": site.email });

const meta = await infoPageMeta("/refunds", copy.refunds.metadata_1);

const sections = copy.refunds.sections_2;
---

<BaseLayout seo={meta.seo}>
  <InfoPage staticHeaderFields={{"eyebrow": "refunds.refunds.eyebrow_3", "title": "refunds.refunds.title_4", "lede": "refunds.refunds.lede_5"}} staticContentPrefix="refunds.refunds.sections_2"
    eyebrow={copy.refunds.eyebrow_3}
    title={copy.refunds.title_4}
    lede={copy.refunds.lede_5}
    sections={sections}
  />
</BaseLayout>
