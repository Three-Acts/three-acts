---
import "../styles.css";
import { shopConfig } from "@three-acts/ecommerce";
import AccountLink from "../components/islands/account-link";
import CartButton from "../components/islands/cart-button";
import NewsletterForm from "../components/islands/newsletter-form";
import { Button } from "../components/ui/button";
import { loadSiteSettings } from "../content/loaders";
import { resolveSeo } from "../lib/seo";
import { formatMoney } from "../lib/format";
import type { SeoMetadata } from "../page-meta/types";
import { footerNav, navLinks, site } from "../site";

type Props = {
  seo: SeoMetadata;
  /** A thin promo/notice bar shown above the header. Defaults to the shop's free-shipping threshold (`@three-acts/ecommerce`'s `shopConfig`). Pass `""` to hide it. */
  announcement?: string;
};

const { seo, announcement } = Astro.props;
const siteSettings = await loadSiteSettings();
const resolved = resolveSeo(seo, siteSettings);
const year = new Date().getFullYear();
const footerDescription = siteSettings.defaultMetaDescription || site.description;
const resolvedAnnouncement =
  announcement ?? `Free delivery on orders over ${formatMoney(shopConfig.shipping.freeOverInclVat, shopConfig.currency)}`;
---

<!doctype html>
<html lang={resolved.locale.replace("_", "-")}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{resolved.title}</title>
    <meta name="description" content={resolved.description} />
    {resolved.keywords && <meta name="keywords" content={resolved.keywords} />}
    <meta name="robots" content={resolved.robots} />
    <link rel="canonical" href={resolved.canonical} />
    <meta name="theme-color" content={"#000000"} />
    <link rel="icon" href={resolved.favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Fonts: Inter only — one grotesque for headings, body and UI. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" />
    <!-- Open Graph -->
    <meta property="og:site_name" content={resolved.siteName} />
    <meta property="og:title" content={resolved.ogTitle} />
    <meta property="og:description" content={resolved.ogDescription} />
    <meta property="og:url" content={resolved.canonical} />
    <meta property="og:type" content={resolved.type} />
    <meta property="og:image" content={resolved.image} />
    <meta property="og:locale" content={resolved.locale} />
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={resolved.twitter} />
    <meta name="twitter:title" content={resolved.ogTitle} />
    <meta name="twitter:description" content={resolved.ogDescription} />
    <meta name="twitter:image" content={resolved.image} />
    <!-- Structured data (SEO + AEO) -->
    <script is:inline type="application/ld+json" set:html={resolved.jsonLd} />
  </head>
  <body>
    <a
      href="#main-content"
      class="focus-ring sr-only bg-ink px-4 py-3 text-body font-medium text-surface focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50"
    >
      Skip to content
    </a>

    <div class="flex min-h-screen flex-col">
      {
        resolvedAnnouncement && (
          <p class="bg-ink px-gutter py-3 text-center text-small text-surface">{resolvedAnnouncement}</p>
        )
      }

      <header class="h-header border-b border-line-strong">
        <div class="mx-auto flex h-full w-full max-w-content items-center justify-between gap-4 px-gutter">
          <a href="/" class="focus-ring text-body font-medium text-ink">
            {resolved.siteName}
          </a>

          <div class="hidden items-center gap-8 landscape:flex">
            <nav aria-label="Primary" class="flex items-center gap-8">
              {
                navLinks.map((item) => (
                  <a href={item.href} class="focus-ring text-body text-ink hover:underline">
                    {item.label}
                  </a>
                ))
              }
            </nav>

            <div class="flex items-center gap-8">
              <slot name="header-actions">
                <CartButton client:load />
                <AccountLink client:load />
              </slot>
            </div>

            <Button.Link href="/shop" variant="secondary" size="sm">
              Shop
            </Button.Link>
          </div>

          {/* Mobile nav: a native <details>/<summary> disclosure — no JavaScript. */}
          <details class="group relative landscape:hidden">
            <summary class="focus-ring flex size-11 list-none cursor-pointer items-center justify-center border border-line-strong [&::-webkit-details-marker]:hidden">
              <span class="sr-only">Menu</span>
              <svg aria-hidden="true" viewBox="0 0 20 20" class="size-5 group-open:hidden">
                <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
              <svg aria-hidden="true" viewBox="0 0 20 20" class="hidden size-5 group-open:block">
                <path d="M4 4l12 12M16 4L4 16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </summary>
            <nav
              aria-label="Mobile"
              class="absolute right-0 top-[calc(100%+1px)] z-40 flex w-64 flex-col gap-1 border border-line-strong bg-surface p-4"
            >
              {
                navLinks.map((item) => (
                  <a href={item.href} class="focus-ring px-1 py-2 text-body text-ink hover:underline">
                    {item.label}
                  </a>
                ))
              }
              <div class="my-2 border-t border-line" />
              <slot name="header-actions">
                <CartButton client:load />
                <AccountLink client:load />
              </slot>
              <div class="mt-3">
                <Button.Link href="/shop" variant="secondary" size="sm" className="w-full justify-center">
                  Shop
                </Button.Link>
              </div>
            </nav>
          </details>
        </div>
      </header>

      <main id="main-content" class="flex-1">
        <slot />
      </main>

      <footer>
        <div class="mx-auto w-full max-w-content px-gutter py-[60px]">
          <div class="flex flex-col gap-12 landscape:flex-row landscape:justify-between">
            <div class="flex max-w-[400px] flex-col gap-4">
              <p class="text-body font-medium text-ink">{resolved.siteName}</p>
              <p class="text-body text-ink">{footerDescription}</p>
              <ul class="flex flex-col gap-1 text-small text-ink">
                <li>{site.address.street}</li>
                <li>
                  {site.address.locality}, {site.address.postalCode}
                </li>
                <li>{site.address.country}</li>
              </ul>
              <ul class="flex flex-col gap-1 text-small text-ink">
                <li>
                  <a href={`mailto:${site.email}`} class="focus-ring hover:underline">
                    {site.email}
                  </a>
                </li>
                <li>
                  <a href={`tel:${site.phoneHref}`} class="focus-ring hover:underline">
                    {site.phone}
                  </a>
                </li>
              </ul>
              <div class="mt-2">
                <slot name="footer-newsletter">
                  <NewsletterForm client:visible />
                </slot>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-8 landscape:flex landscape:gap-16">
              {
                footerNav.map((group) => (
                  <nav aria-label={group.title}>
                    <p class="text-small font-medium uppercase tracking-eyebrow text-ink">{group.title}</p>
                    <ul class="mt-4 flex flex-col gap-2.5">
                      {group.links.map((link) => (
                        <li>
                          <a href={link.href} class="focus-ring text-body text-ink hover:underline">
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </nav>
                ))
              }
            </div>
          </div>

          <div class="mt-[60px] flex flex-col gap-4 border-t border-line-strong pt-8 landscape:flex-row landscape:items-center landscape:justify-between">
            <p class="text-small text-ink">
              © {year} {resolved.siteName}. All rights reserved.
            </p>
            <ul class="flex items-center gap-6 text-small text-ink">
              <li>
                <a href="/terms" class="focus-ring hover:underline">
                  Terms
                </a>
              </li>
              <li>
                <a href="/privacy" class="focus-ring hover:underline">
                  Privacy
                </a>
              </li>
            </ul>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
