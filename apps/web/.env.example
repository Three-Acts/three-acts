# Public site origin — controls canonical URLs, sitemap locations, and social tags.
VITE_SITE_URL=https://example.com

# API bridge origin. In dev the Vite server proxies /api/* here; in Vercel the
# rewrite in vercel.ts performs the same bridge so browser calls stay same-origin.
API_ORIGIN=http://localhost:5175

# Optional: call the API directly from the browser instead of the same-origin
# /api/* bridge above. Must be PUBLIC_-prefixed (not VITE_-prefixed) so Astro
# exposes it to client-side code, e.g. the hydrated dashboard and contact form.
# Requires API_ALLOWED_ORIGINS on the API app to allow this origin.
# PUBLIC_API_URL=https://your-api.vercel.app

# Content backend. "api" (recommended for real development — it's the only
# way to see live editorial changes and the full shop/order data) reads
# published content from this project's own API (apps/api) via
# @three-acts/content; unset or "mock" uses zero-config seed data instead, so
# the site still builds and runs fully offline with no API server at all.
# The API route is public and read-only — it only ever returns "published"
# records, so no auth is required here.
CONTENT_SOURCE=api

# Origin the "api" content source reads from. Defaults to API_ORIGIN above;
# set this only when content should come from a different origin than the
# same-origin /api/* bridge (e.g. pointing a preview build at production data).
# CONTENT_API_ORIGIN=http://localhost:5175
